# Copy to .env and fill in. .env is gitignored.
# Never commit real values. Never paste real values into issues, PRs, commits, logs, or chat.

# Last.fm API — primary source for artist/track similarity graph + listening cache.
# Get key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Spotify Web API — used for ISRC retrieval, clean genres, popularity, image.
# NOTE: our app is NOT grandfathered — no audio-features, no related-artists, no recommendations.
# Client credentials flow only at v0.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Backfill playlist (#127) — opt-in, off by default. First feature needing
# user-OAuth (authorization-code + PKCE, no client secret) on top of the
# client-credentials flow above: adds user-library-read + playlist-modify-*
# scopes. Run `music-intel spotify-login` once to authorize; the token is
# written to a local file only (never to the shared Supabase store).
MUSIC_INTEL_BACKFILL_PLAYLIST_ENABLED=

# AcousticBrainz / MusicBrainz dump locations on local disk.
# Large dumps live OUTSIDE the repo. Point these to wherever you extracted them.
MUSICBRAINZ_DUMP_DIR=
ACOUSTICBRAINZ_DUMP_DIR=

# Prebuilt ISRC -> recording-MBID index (TSV) for the identity waterfall (#61).
# Derived from the MusicBrainz dump; also lives OUTSIDE the repo. If unset, the
# resolver falls back to $MUSICBRAINZ_DUMP_DIR/isrc_to_mbid.tsv.
MUSICBRAINZ_ISRC_INDEX=

# AcoustID — fingerprint-based identity resolution fallback.
ACOUSTID_API_KEY=

# MusicBrainz API contact (required by MB's API etiquette — set to an email or
# app URL). Used for genre lookups in the tag-enrichment composite source.
MUSICBRAINZ_APP_CONTACT=

# Discogs — style tag source in the tag-enrichment composite source.
DISCOGS_TOKEN=